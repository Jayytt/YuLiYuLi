# Infrastructure
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_DATABASE=yuliyuli
MYSQL_PORT=3306
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379
MONGODB_PORT=27017
NACOS_PORT=8848
ELASTICSEARCH_PORT=9200
ROCKETMQ_NAMESRV_PORT=9876

# Nacos
NACOS_PASSWORD=nacos

# Service-specific DB URLs (using container names)
SPRING_DATASOURCE_URL_USER=jdbc:mysql://mysql:3306/yuliyuli_user?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_URL_VIDEO=jdbc:mysql://mysql:3306/yuliyuli_video?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_URL_COMMENT=jdbc:mysql://mysql:3306/yuliyuli_comment?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_URL_FAVORITE=jdbc:mysql://mysql:3306/yuliyuli_favorite?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_URL_FOLLOW=jdbc:mysql://mysql:3306/yuliyuli_follow?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_URL_MESSAGE=jdbc:mysql://mysql:3306/yuliyuli_message?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_URL_ADMIN=jdbc:mysql://mysql:3306/yuliyuli_admin?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_URL_CONFIG=jdbc:mysql://mysql:3306/yuliyuli_config?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_URL_STATISTICS=jdbc:mysql://mysql:3306/yuliyuli_statistics?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai

# MySQL credentials for services
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Redis
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=your_redis_password

# Nacos
SPRING_CLOUD_NACOS_DISCOVERY_SERVER-ADDR=nacos:8848
SPRING_CLOUD_NACOS_DISCOVERY_USERNAME=nacos
SPRING_CLOUD_NACOS_DISCOVERY_PASSWORD=your_nacos_password

# RocketMQ
ROCKETMQ_NAME-SERVER=rocketmq-namesrv:9876

# MongoDB
SPRING_DATA_MONGODB_URI_DANMAKU=mongodb://mongodb:27017/yuliyuli_danmaku
SPRING_DATA_MONGODB_URI_FEED=mongodb://mongodb:27017/yuliyuli_feed
SPRING_DATA_MONGODB_URI_RECOMMEND=mongodb://mongodb:27017/yuliyuli_recommend

# Elasticsearch
SPRING_DATA_ELASTICSEARCH_URIS=http://elasticsearch:9200

# JWT
JWT_SECRET=your_jwt_secret_at_least_32_bytes

# Video upload
VIDEO_UPLOAD_DIR=./uploads/videos
VIDEO_COVER_DIR=./uploads/covers

# Frontend
NEXT_PUBLIC_API_URL=http://gateway:8080
